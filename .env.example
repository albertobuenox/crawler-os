# Copia este archivo a .env.local:
#   cp .env.example .env.local
# O deja que npm run setup:local lo genere contra Supabase local.

# --- Opción A: Supabase local (recomendado para pruebas multi-cliente) ---
# En LAN, las otras PCs abren http://<IP-del-anfitrión>:3000
# El cliente reescribe 127.0.0.1 → esa IP para Realtime.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwiYXVkIjoiYXV0aGVudGljYXRlZCIsInJvbGUiOiJhbm9uIiwiZXhwIjoyMDI0NzkyMDAwfQ.EcWI1qpUkXxdidj6qNEQ5w5ZUjoDWE8HsEVMs_gL0YM
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwiYXVkIjoiYXV0aGVudGljYXRlZCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJleHAiOjIwMjQ3OTIwMDB9.DaYlNEoUrrEn2Ig7tqibS-eHce1K6ia-d8W0pNpp7N8

# --- Opción B: proyecto hosted (supabase.com) ---
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login sin contraseña: la service_role es necesaria para entrar como DM / crawler
NEXT_PUBLIC_DEV_LOGIN=true
